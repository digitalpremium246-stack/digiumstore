# Required for database-backed production runtime
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require"

# NextAuth v4
NEXTAUTH_SECRET="generate-a-long-random-secret"
NEXTAUTH_URL="https://your-production-domain.example"

# AI Stylist
OPENAI_API_KEY=""
# Virtual try-on provider. Existing Fashn integration is incomplete; see REMAINING_BLOCKERS.md.
FASHN_AI_API_KEY=""

# Cloudflare R2 (optional until storage code is wired into upload routes)
CLOUDFLARE_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME="digiumstore-private"
R2_PUBLIC_URL=""

# Midtrans
MIDTRANS_SERVER_KEY=""
MIDTRANS_CLIENT_KEY=""
MIDTRANS_IS_PRODUCTION="false"

# Upstash rate limiting (only if rate-limit module is enabled)
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Biteship shipping (adapter is currently a placeholder)
BITESHIP_API_KEY=""
